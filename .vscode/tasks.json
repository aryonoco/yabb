{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "nim: build debug",
      "type": "shell",
      "command": "nim",
      "args": ["c", "-g", "--debugger:native", "-o:bin/${fileBasenameNoExtension}", "${relativeFile}"],
      "group": "build",
      "problemMatcher": ["$nim"]
    },
    {
      "label": "nim: build release",
      "type": "shell",
      "command": "nim",
      "args": ["c", "-d:release", "-o:bin/${fileBasenameNoExtension}", "${relativeFile}"],
      "group": "build",
      "problemMatcher": ["$nim"]
    },
    {
      "label": "nim: build project debug",
      "type": "shell",
      "command": "nim",
      "args": ["c", "-g", "--debugger:native", "-o:bin/yabb", "src/yabb.nim"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$nim"]
    },
    {
      "label": "nim: build project release",
      "type": "shell",
      "command": "nim",
      "args": ["c", "-d:release", "-d:lto", "-o:bin/yabb", "src/yabb.nim"],
      "group": "build",
      "problemMatcher": ["$nim"]
    },
    {
      "label": "nim: format (nimpretty)",
      "type": "shell",
      "command": "nimpretty",
      "args": ["${file}"],
      "problemMatcher": []
    },
    {
      "label": "nim: format all",
      "type": "shell",
      "command": "find",
      "args": ["src", "-name", "*.nim", "-exec", "nimpretty", "{}", ";"],
      "problemMatcher": []
    },
    {
      "label": "nimble: build",
      "type": "shell",
      "command": "nimble",
      "args": ["build"],
      "group": "build",
      "problemMatcher": ["$nim"]
    },
    {
      "label": "nimble: test",
      "type": "shell",
      "command": "nimble",
      "args": ["test"],
      "group": "test",
      "problemMatcher": ["$nim"]
    },
    {
      "label": "nimble: install",
      "type": "shell",
      "command": "nimble",
      "args": ["install"],
      "problemMatcher": []
    },
    {
      "label": "nim: run tests (testament)",
      "type": "shell",
      "command": "testament",
      "args": ["all"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "nim: generate docs",
      "type": "shell",
      "command": "nim",
      "args": ["doc", "--project", "--index:on", "-o:docs/", "src/yabb.nim"],
      "problemMatcher": []
    },
    {
      "label": "nim: run current file",
      "type": "shell",
      "command": "nim",
      "args": ["c", "-r", "${relativeFile}"],
      "problemMatcher": ["$nim"]
    }
  ]
}
