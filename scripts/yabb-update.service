# =============================================================================
# YABB Update Service
# Fetches and installs the latest YABB release from GitHub
# =============================================================================
# Installation (copy both files, then enable):
#   sudo cp yabb-update.service yabb-update.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now yabb-update.timer
#
# Manual run:  sudo systemctl start yabb-update.service
# =============================================================================

[Unit]
Description=YABB Update Service
Documentation=https://github.com/aryonoco/yabb
After=network-online.target
Wants=network-online.target

# Only run if install script exists
ConditionPathExists=/opt/yabb/install.sh


[Service]
Type=oneshot
RemainAfterExit=no

# Pre-flight check: verify script is executable
ExecCondition=/usr/bin/test -x /opt/yabb/install.sh

# Run the installer with --force to update even if already installed
ExecStart=/opt/yabb/install.sh --force

# Timeouts
TimeoutStartSec=300
TimeoutStopSec=30

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
Environment=HOME=/root
EnvironmentFile=-/etc/yabb/update.conf

# -----------------------------------------------------------------------------
# Filesystem & Mount Isolation
# -----------------------------------------------------------------------------
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=full
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid

# Allow writes to installation directory and config
ReadWritePaths=/opt/yabb
ReadWritePaths=-/etc/yabb.toml

# -----------------------------------------------------------------------------
# Kernel Protection
# -----------------------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
ProtectClock=yes
ProtectHostname=yes

# -----------------------------------------------------------------------------
# Privilege Restriction
# -----------------------------------------------------------------------------
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes

# -----------------------------------------------------------------------------
# System Call Filtering
# -----------------------------------------------------------------------------
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @cpu-emulation @debug @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM

# -----------------------------------------------------------------------------
# Network (required for GitHub downloads)
# -----------------------------------------------------------------------------
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# -----------------------------------------------------------------------------
# Namespace Isolation
# -----------------------------------------------------------------------------
RestrictNamespaces=yes
PrivateDevices=yes
DevicePolicy=closed
KeyringMode=private

# -----------------------------------------------------------------------------
# Memory Protection
# -----------------------------------------------------------------------------
MemoryDenyWriteExecute=yes
RestrictRealtime=yes

# -----------------------------------------------------------------------------
# Resource Limits
# -----------------------------------------------------------------------------
LimitNOFILE=1024
LimitNPROC=64
TasksMax=16
MemoryMax=512M

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yabb-update
LogLevelMax=info


[Install]
WantedBy=multi-user.target
